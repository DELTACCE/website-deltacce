# Formspree endpoint configuration for contact form submissions.
# Duplicate this file, rename it to '.env', and paste your endpoint URL below.
# Example: https://formspree.io/f/your_form_id
REACT_APP_FORMSPREE_ENDPOINT=

# Cloudinary client-side asset list configuration.
# Public cloud name only. No API secret or backend SDK is needed.
REACT_APP_CLOUDINARY_CLOUD_NAME=dt9kum1nb
